---
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import type { CollectionEntry } from 'astro:content';
import readingTime from 'reading-time';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, excerpt, categories } = post.data;
const stats = readingTime(post.body ?? '');
---

<BaseLayout title={title} description={excerpt}>
  <article class="prose mx-auto">
    <header class="mb-10 not-prose">
      <h1 class="font-serif text-4xl md:text-5xl font-semibold leading-tight tracking-tight mb-4">
        {title}
      </h1>
      <PostMeta date={date} readingTime={stats.text} categories={categories} />
    </header>
    <slot />
  </article>
</BaseLayout>

<style>
  article :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.625rem;
  }
  article :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }
  article :global(p) {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }
  article :global(ul),
  article :global(ol) {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  article :global(li) {
    margin-top: 0.5rem;
  }
  article :global(pre) {
    padding: 1rem;
    border-radius: 0.375rem;
    overflow-x: auto;
    background: var(--color-rule);
  }
  :global(html.dark) article :global(pre) {
    background: var(--color-rule-dark);
  }
  article :global(code) {
    padding: 0.1em 0.3em;
    border-radius: 0.25rem;
    background: var(--color-rule);
  }
  :global(html.dark) article :global(code) {
    background: var(--color-rule-dark);
  }
  article :global(pre code) {
    padding: 0;
    background: transparent;
  }
  article :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-rule);
  }
  :global(html.dark) article :global(hr) {
    border-top-color: var(--color-rule-dark);
  }
  article :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--color-rule);
    font-style: italic;
    color: var(--color-ink-muted);
  }
  :global(html.dark) article :global(blockquote) {
    border-left-color: var(--color-rule-dark);
    color: var(--color-ink-muted-dark);
  }
</style>
