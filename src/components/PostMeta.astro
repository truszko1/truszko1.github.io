---
interface Props {
  date: Date;
  readingTime?: string;
  categories?: string[];
}

const { date, readingTime, categories } = Astro.props;
const formatted = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<div class="flex flex-wrap items-center gap-3 text-sm" style="color: var(--color-ink-muted);">
  <time datetime={date.toISOString()}>{formatted}</time>
  {readingTime && (
    <>
      <span aria-hidden="true">·</span>
      <span>{readingTime}</span>
    </>
  )}
  {categories && categories.length > 0 && (
    <>
      <span aria-hidden="true">·</span>
      <span class="uppercase tracking-wider text-xs">{categories.join(', ')}</span>
    </>
  )}
</div>

<style>
  :global(html.dark) div {
    color: var(--color-ink-muted-dark) !important;
  }
</style>
