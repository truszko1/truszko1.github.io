---
---

<header class="px-6 pt-10 pb-4 border-b" style="border-color: var(--color-rule);">
  <div class="max-w-2xl mx-auto">
    <a href="/" class="flex items-center gap-3 no-underline">
      <img
        src="/logo.png"
        alt="Rafał Truszkowski logo"
        class="h-10 w-10 rounded-full object-cover"
      />
      <div>
        <div class="font-serif text-xl font-semibold tracking-tight text-current">
          Rafał Truszkowski
        </div>
        <p class="mt-1 text-sm" style="color: var(--color-ink-muted);">
          I lead engineering teams and write about what I'm figuring out.
        </p>
      </div>
    </a>
  </div>
</header>

<style>
  :global(html.dark) header {
    border-color: var(--color-rule-dark) !important;
  }
  :global(html.dark) header p {
    color: var(--color-ink-muted-dark) !important;
  }
</style>
