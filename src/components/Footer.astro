---
const year = new Date().getFullYear();
---

<footer class="px-6 py-10 mt-16 border-t" style="border-color: var(--color-rule);">
  <div class="max-w-2xl mx-auto flex flex-wrap items-center justify-between gap-4 text-sm" style="color: var(--color-ink-muted);">
    <span>&copy; {year} Rafał Truszkowski</span>
    <nav class="flex gap-5">
      <a href="mailto:contact@rafaltruszkowski.com" class="no-underline hover:underline">Email</a>
      <a href="https://www.linkedin.com/in/rafal-truszkowski/" class="no-underline hover:underline" rel="me">LinkedIn</a>
      <a href="/feed.xml" class="no-underline hover:underline">RSS</a>
    </nav>
  </div>
</footer>

<style>
  :global(html.dark) footer {
    border-color: var(--color-rule-dark) !important;
    color: var(--color-ink-muted-dark) !important;
  }
  footer a {
    color: inherit;
  }
</style>
